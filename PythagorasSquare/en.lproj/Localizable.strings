// Number 1
"pythagoras_number_1_one" = "You have 1 one. This indicates character, willpower, and determination. You have leadership potential but don't always use it.";
"pythagoras_number_1_two" = "You have 2 ones. You possess strong character, determination, and pronounced leadership qualities.";
"pythagoras_number_1_many" = "You have %d ones. This indicates very strong willpower, stubbornness, and a pronounced desire for leadership. You don't tolerate objections and always strive to be first.";
"pythagoras_number_1_none" = "No ones indicate a gentle character, lack of initiative and willpower. You find it hard to insist on your own, but you adapt well to circumstances.";

// Number 2
"pythagoras_number_2_one" = "You have 1 two. This indicates balance, ability to compromise and diplomacy. You know how to find balance in relationships.";
"pythagoras_number_2_two" = "You have 2 twos. You have good diplomatic skills, listen to others and find common ground with different people.";
"pythagoras_number_2_many" = "You have %d twos. This indicates outstanding diplomatic abilities, peacefulness and tendency to cooperate. You're a born peacemaker and mediator.";
"pythagoras_number_2_none" = "No twos may indicate lack of flexibility in relationships, difficulty in finding compromises. You may find it hard to accept others' viewpoints.";

// Number 3
"pythagoras_number_3_one" = "You have 1 three. This indicates creative potential and self-expression. You're capable of unconventional thinking.";
"pythagoras_number_3_two" = "You have 2 threes. You have bright creative thinking, rich imagination and desire for self-expression.";
"pythagoras_number_3_many" = "You have %d threes. This indicates exceptional creativity, rich imagination and original thinking. You were born for creativity and self-expression.";
"pythagoras_number_3_none" = "No threes may indicate predominance of logical over creative thinking, some restraint in self-expression. You may lack imagination.";

// Number 4
"pythagoras_number_4_one" = "You have 1 four. This indicates certain methodicalness, stability and work capacity. You're capable of systematic work.";
"pythagoras_number_4_two" = "You have 2 fours. You have good work capacity, practicality and methodicalness. You're reliable and thorough.";
"pythagoras_number_4_many" = "You have %d fours. This indicates outstanding work capacity, practicality and methodicalness. You're very reliable, responsible and thorough in everything you do.";
"pythagoras_number_4_none" = "No fours may indicate lack of practicality and methodicalness. You may find routine work difficult and struggle to complete tasks.";

// Number 5
"pythagoras_number_5_one" = "You have 1 five. This indicates curiosity, desire for novelty and change. You dislike stagnation and routine.";
"pythagoras_number_5_two" = "You have 2 fives. You have strong desire for new experiences, curiosity and desire for freedom. You need change and variety.";
"pythagoras_number_5_many" = "You have %d fives. This indicates pronounced desire for freedom, adventurousness and thirst for new experiences. You can't stand limitations and monotony.";
"pythagoras_number_5_none" = "No fives may indicate conservatism, fear of change and tendency to familiar lifestyle. You're more comfortable in stable, predictable environment.";

// Number 6
"pythagoras_number_6_one" = "You have 1 six. This indicates responsibility, caring nature and family values. You're capable of compassion and caring for others.";
"pythagoras_number_6_two" = "You have 2 sixes. You have strong sense of responsibility, care for loved ones and commitment to family values. You're reliable and caring.";
"pythagoras_number_6_many" = "You have %d sixes. This indicates outstanding ability to care, strong family attachment and high sense of responsibility. Caring for others is your calling.";
"pythagoras_number_6_none" = "No sixes may indicate difficulty expressing care and compassion, some detachment in relationships. You may find it hard to take responsibility for others.";

// Number 7
"pythagoras_number_7_one" = "You have 1 seven. This indicates analytical skills, intellectuality and spiritual search. You're capable of deep thinking.";
"pythagoras_number_7_two" = "You have 2 sevens. You have strong analytical mind, desire for knowledge and spiritual development. You're a deep thinker.";
"pythagoras_number_7_many" = "You have %d sevens. This indicates outstanding intellectual abilities, deep wisdom and strong spiritual quest. You're a philosopher and thinker by nature.";
"pythagoras_number_7_none" = "No sevens may indicate predominance of practical over theoretical thinking, some superficiality in judgments. You may lack inclination for deep analysis.";

// Number 8
"pythagoras_number_8_one" = "You have 1 eight. This indicates certain organizational skills, business acumen and material ambitions. You can achieve financial wellbeing.";
"pythagoras_number_8_two" = "You have 2 eights. You have good organizational skills, business sense and desire for material success. You're a born manager.";
"pythagoras_number_8_many" = "You have %d eights. This indicates outstanding business abilities, management skills and achievement of material wellbeing. You were born to be a leader in business.";
"pythagoras_number_8_none" = "No eights may indicate lack of business acumen, organizational skills and material ambitions. You may find it hard to achieve financial wellbeing.";

// Number 9
"pythagoras_number_9_one" = "You have 1 nine. This indicates ability for compassion, altruism and humanistic ideals. You can think about others' good.";
"pythagoras_number_9_two" = "You have 2 nines. You have strong sense of justice, altruism and humanistic values. You strive to make the world better.";
"pythagoras_number_9_many" = "You have %d nines. This indicates high level of altruism, compassion and devotion to humanistic ideals. Your calling is to help others and improve the world.";
"pythagoras_number_9_none" = "No nines may indicate predominance of personal over public interests, some egocentrism. You may find it hard to sacrifice your interests for others.";

